. capture gen OOP_OUTPATIENT = m3ct1 / 1000

. 
. keep IDHO tinh huyen xa diaban RURAL INC_PC_MIL ln_INC tsnguoi OOP_HH OOP_INPATIENT OOP_OUTPATIENT

