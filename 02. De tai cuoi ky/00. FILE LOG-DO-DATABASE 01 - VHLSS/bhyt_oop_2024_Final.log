. gen RURAL = (ttnt == 2) 

. 
. * Thu nhập bình quân (Triệu đồng) và Log(Thu nhập)
. gen INC_HH_MIL = tongthu / 1000 

. gen INC_PC_MIL = INC_HH_MIL / tsnguoi

. gen ln_INC = ln(INC_PC_MIL + 1)

. 
. * Tổng chi OOP hộ (đơn vị: triệu đồng) 
